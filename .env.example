# Local Docker settings for docker-compose.yml. Every value has a working default, so
# `docker compose up` works without any of these. If you already have a .env (for running
# uvicorn directly), just append the lines you want to change; it is safe to share:
# the compose stack ignores MYSQL_*, DATABASE_URL, BASE_URL, FRONTEND_URL and APP_PROFILE from it.

# Where Vector_Frontend is checked out, relative to this repo
FRONTEND_DIR=../Frontend

# Host ports
WEB_PORT=8190
API_PORT=8191
LOCAL_MYSQL_PORT=3316

# MySQL container (connect from your machine on localhost:3316)
LOCAL_MYSQL_ROOT_PASSWORD=root
LOCAL_MYSQL_DATABASE=outreach_ai
LOCAL_MYSQL_USER=vector
LOCAL_MYSQL_PASSWORD=vector

JWT_SECRET_KEY=local-dev-only-change-me-0123456789abcdef

# Integrations (optional)
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SENDER_EMAIL=
