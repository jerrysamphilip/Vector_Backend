# Coverage gate (docs/CI_GATES.md "Coverage"): measured per layer by pytest-cov, compared with
# ci/coverage_floor.json by scripts/ci/check_coverage.py.
[run]
source = app
branch = True
relative_files = True
# Functional tests run the app in-process; threads started by the app are measured too.
concurrency = thread
# app/db holds migration helpers and seed scripts, not application logic. They run only when a test
# process migrates the schema itself (locally) and not in CI (migrated in a separate step), so
# including them would make the totals depend on where the tests run.
omit =
    app/db/*

[report]
skip_empty = True
precision = 2
