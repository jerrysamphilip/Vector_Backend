# C-4 / C-5 import contracts (NTS Build Standard Addendum; docs/CI_GATES.md, docs/ARCHITECTURE.md).
# Run:  lint-imports            (CI: unit job, blocking)
#
# Layering, top to bottom (a module may import from its own layer or any layer below it):
#   app.main / app.worker   process entry points
#   app.jobs                background loops
#   app.routers | app.db    HTTP adapters | migrations + seed scripts (independent of each other)
#   app.services            business logic
#   app.schemas | app.prompts   request/response models | LLM prompt text
#   app.utils               pure helpers
#   app.models              ORM models
#   app.core                config, database, auth, errors, security primitives
#
# BASELINE (2026-10-18): the `ignore_imports` entries below are the violations that exist today.
# They are a ratchet: entries may only be removed (fix the import, then delete the line); new ones
# are not accepted. Each carries a TODO with the intended fix.
#
# L0 target-layer contracts (ADR 0009, docs/REFACTOR_PLAN.md "Target architecture"), at the end of
# this file: route / service / domain / repository / adapter rules. Their violations sit in sections
# marked "BASELINE 2026-10 (shrink only; see REFACTOR_PLAN.md)", generated by
# scripts/ci/gen_import_baseline.py; they shrink aggregate by aggregate (chunks L1, A1-A8, S2).
# A stale entry (an ignore that no longer matches an import) fails lint-imports, like the entries above
# (unmatched_ignore_imports_alerting defaults to "error").
#
# include_external_packages = True is needed to forbid sqlalchemy / fastapi. Grimp squashes an external
# package to its top-level name, so a contract cannot tell sqlalchemy.orm.Session from sqlalchemy.select:
# routers are forbidden all of sqlalchemy. The target for `db: Session = Depends(get_db)` is a typed
# alias exported by app.core.database (e.g. `DbSession = Annotated[Session, Depends(get_db)]`).

[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:layers]
name = C-4 layered architecture (entry points > jobs > routers|db > services > schemas|prompts > utils > models > core)
type = layers
layers =
    app.main | app.worker
    app.jobs
    app.routers | app.db
    app.services
    app.schemas | app.prompts
    app.utils
    app.models
    app.core
ignore_imports =
    # --- BASELINE 2026-10-18 (may only shrink) ---
    # TODO(C-4): auth resolves the current User/Tenant; move the lookup into a service and pass it in.
    app.core.auth -> app.models.user
    app.core.auth -> app.models.tenant
    # TODO(C-4): token revocation / activity checks belong in a service-level dependency, not app.core.auth.
    app.core.auth -> app.services.token_revocation
    app.core.auth -> app.services.user_activity
    # TODO(C-4): MAX_MENTIONS is a shared constant; move it to app.core or app.schemas.
    app.schemas.contact_schema -> app.services.mentions
    # TODO(C-4): the classifier should receive the LLM budget hooks from its service caller.
    app.utils.reply_classifier -> app.services.llm_budget
    # TODO(C-4): the job lock helpers (try_acquire/release) belong in app.core or a service module.
    app.services.contact_scoring -> app.jobs

[importlinter:contract:core-no-upper]
name = C-5 app.core must not import app.services, app.routers, app.jobs or app.db
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.services
    app.routers
    app.jobs
    app.db
ignore_imports =
    # --- BASELINE 2026-10-18 (may only shrink); same TODOs as the layers contract ---
    app.core.auth -> app.services.token_revocation
    app.core.auth -> app.services.user_activity

[importlinter:contract:services-no-routers]
name = C-5 app.services must not import app.routers (HTTP stays in the adapters)
type = forbidden
source_modules =
    app.services
    app.core
    app.utils
    app.models
    app.schemas
forbidden_modules =
    app.routers

[importlinter:contract:no-cycles]
name = C-5 no import cycles between the app sub-packages
type = acyclic_siblings
ancestors =
    app
ignore_imports =
    # --- BASELINE 2026-10-18 (may only shrink); the layer violations above close these package cycles ---
    app.core.auth -> app.models.user
    app.core.auth -> app.models.tenant
    app.core.auth -> app.services.token_revocation
    app.core.auth -> app.services.user_activity
    app.schemas.contact_schema -> app.services.mentions
    app.utils.reply_classifier -> app.services.llm_budget
    app.services.contact_scoring -> app.jobs
    # TODO(C-5): cycles inside app.services, broken today by function-local imports. Fix by moving the
    # shared helper (crm._fmt -> app.utils) or inverting the call (sales/campaign_email callbacks).
    app.services.contact_service -> app.services.sales
    app.services.webhooks -> app.services.crm
    app.services.workflow -> app.services.crm

# ---------------------------------------------------------------------------------------------------
# L0 target layers (ADR 0009). Direct imports only (allow_indirect_imports) except for app.domain:
# a router may call a service that still uses SQLAlchemy; the domain layer must be pure end to end.
# Baselines: regenerate with `python scripts/ci/gen_import_baseline.py --update` after removing
# imports (it refuses to add entries). Never hand-add a line to a BASELINE 2026-10 block.
# ---------------------------------------------------------------------------------------------------

# TODO(L1, A1-A8): move queries into app/repositories/<aggregate>.py, call one service function,
# map the result to a response model; type `db` through an app.core alias instead of sqlalchemy.orm.
[importlinter:contract:routers-thin]
name = L0 app.routers must not import sqlalchemy, app.models or app.repositories (routes call services)
type = forbidden
source_modules =
    app.routers
forbidden_modules =
    sqlalchemy
    app.models
    app.repositories
allow_indirect_imports = True
ignore_imports =
    # --- BASELINE 2026-10 (shrink only; see REFACTOR_PLAN.md) ---
    app.routers.ai_email_router -> app.models
    app.routers.ai_email_router -> app.models.user
    app.routers.ai_email_router -> sqlalchemy
    app.routers.company_profile_router -> app.models.company_profile
    app.routers.company_profile_router -> app.models.user
    app.routers.company_profile_router -> sqlalchemy
    app.routers.connections_router -> app.models.sales_extra
    app.routers.connections_router -> app.models.user
    app.routers.connections_router -> sqlalchemy
    app.routers.ses_webhook_router -> app.models
    app.routers.ses_webhook_router -> app.models.campaign
    app.routers.ses_webhook_router -> app.models.conversation
    app.routers.ses_webhook_router -> sqlalchemy
    app.routers.subject_variant_router -> app.models.campaign
    app.routers.subject_variant_router -> app.models.user
    app.routers.subject_variant_router -> sqlalchemy
    app.routers.tracking_router -> app.models
    app.routers.tracking_router -> app.models.prospect
    app.routers.tracking_router -> sqlalchemy

# TODO(L1, A1-A8): services call repositories (SQL) through Protocols and own the unit of work;
# FastAPI types (HTTPException, UploadFile, BackgroundTasks, ...) stay in the routers (ADR 0001).
[importlinter:contract:services-no-sql]
name = L0 app.services must not import sqlalchemy or fastapi (SQL in repositories, HTTP in routers)
type = forbidden
source_modules =
    app.services
forbidden_modules =
    sqlalchemy
    fastapi
allow_indirect_imports = True
ignore_imports =
    # --- BASELINE 2026-10 (shrink only; see REFACTOR_PLAN.md) ---
    app.services.account_sync -> sqlalchemy
    app.services.ai_email_service -> sqlalchemy
    app.services.audit_service -> sqlalchemy
    app.services.batch_processor_service -> sqlalchemy
    app.services.compliance_service -> sqlalchemy
    app.services.daily_limit -> sqlalchemy
    app.services.enrollment_rules -> sqlalchemy
    app.services.llm_budget -> sqlalchemy
    app.services.mentions -> sqlalchemy
    app.services.metrics_service -> sqlalchemy
    app.services.ms365_oauth -> sqlalchemy
    app.services.oauth_binding -> fastapi
    app.services.platform_flags -> sqlalchemy
    app.services.prospect_upload_service -> sqlalchemy
    app.services.provider_ingestion_service -> sqlalchemy
    app.services.reconnect_service -> sqlalchemy
    app.services.sender_identity -> sqlalchemy
    app.services.suppression -> sqlalchemy
    app.services.user_activity -> sqlalchemy
    app.services.workflow -> sqlalchemy

[importlinter:contract:domain-pure]
name = L0 app.domain is pure: no sqlalchemy, fastapi, models, services, repositories or routers (indirect too)
type = forbidden
source_modules =
    app.domain
forbidden_modules =
    sqlalchemy
    fastapi
    app.models
    app.services
    app.repositories
    app.routers

[importlinter:contract:repositories-no-upper]
name = L0 app.repositories must not import app.services, app.routers or fastapi
type = forbidden
source_modules =
    app.repositories
forbidden_modules =
    app.services
    app.routers
    fastapi
allow_indirect_imports = True

[importlinter:contract:adapters-no-upper]
name = L0 app.adapters must not import app.services or app.routers
type = forbidden
source_modules =
    app.adapters
forbidden_modules =
    app.services
    app.routers
allow_indirect_imports = True
